# Production environment variables (Render + TiDB Cloud Serverless).
# Set these in the Render dashboard; never commit real values.

APP_NAME=Taskly
APP_ENV=production
APP_DEBUG=false
# Generate with: php artisan key:generate --show
APP_KEY=
APP_URL=https://your-service.onrender.com

# TiDB Cloud Serverless requires TLS.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=4000
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# The free Render plan has no persistent disk, background workers or cron.
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
MAIL_MAILER=log

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
